---
interface Props { title: string; lead?: string; updated: Date | string; eyebrow?: string; draft?: boolean; sub?: string; byline?: boolean }
import { SITE } from '../data/site';
import Draft from './Draft.astro';
const { title, lead, updated, eyebrow, draft = false, sub, byline = false } = Astro.props;
const d = (typeof updated === 'string' ? new Date(updated) : updated).toISOString().slice(0, 10);
---
<header class="page-head">
  {eyebrow && <div class="eyebrow" style="margin-bottom:6px">{eyebrow}</div>}
  <h1>{title}</h1>
  {sub && <div class="lead">{sub}</div>}
  {lead && <p class="lead">{lead}{draft && <Draft />}</p>}
  <slot />
  <p class="updated">最終更新 <time datetime={d}>{d}</time>{byline && <> ／ 文責 <a href="/about/">{SITE.representative}</a>（{SITE.jobTitle}）</>}</p>
</header>
