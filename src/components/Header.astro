---
import { SITE, NAV } from '../data/site';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <span class="sq" aria-hidden="true"></span>
      <span>{SITE.name}<small>KYOTO / REMOTE NATIONWIDE</small></span>
    </a>
    <nav class="gnav gnav-pc" aria-label="グローバルナビゲーション">
      <ul>
        {NAV.map((n) => (
          <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="btn nav-btn" href="/contact/" aria-current={path.startsWith('/contact/') ? 'page' : undefined}>お問い合わせ</a>
    <details class="menu">
      <summary><span class="bars" aria-hidden="true"></span><span class="menu-label">メニュー</span></summary>
      <nav class="gnav gnav-sp" aria-label="メニュー">
        <ul>
          {NAV.map((n) => (
            <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
